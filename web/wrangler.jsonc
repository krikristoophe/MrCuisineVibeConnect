{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claudimix",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "claudimix", "database_id": "293471c5-a598-4e47-9f57-4b36a24f315d", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "ROBOT", "class_name": "RobotHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RobotHub"] }],
  "vars": {
    "GOOGLE_CLIENT_ID": "514667460201-lr3lrljbl4jusa52lu8ptt0vvu5g3lcd.apps.googleusercontent.com",
    "VAPID_PUBLIC_KEY": "BNYBCW4JS9z-mVz2EY1XaUEH6nJo3DFtokj5bXfWdv3-AhVG3L9K6fUR33SJmu6i513GqYfluEuMx00rBrCyz30",
    "VAPID_SUBJECT": "https://claudimix.krikristoophe.workers.dev"
  },
  "triggers": { "crons": ["17 3 * * *"] }
}
